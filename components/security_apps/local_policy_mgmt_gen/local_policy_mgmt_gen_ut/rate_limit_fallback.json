{
    "apiVersion": "v1beta2",
    "policies": {
        "default": {
            "mode": "prevent",
            "threatPreventionPractices": [],
            "accessControlPractices": ["limit"],
            "customResponse": ""
        },
        "specificRules": []
    },
    "accessControlPractices": [
        {
            "name": "limit",
            "rateLimit": {
                "overrideMode": "prevent",
                "rules": [{"limit": 10, "uri": "/", "unit": "second"}]
            }
        }
    ],
    "customResponses": [
        {"name": "unused", "mode": "response-code-only", "httpResponseCode": 429}
    ],
    "autoUpgrade": {"mode": "manual"}
}
